# Copy to .env and adjust. Never commit .env.

APP_ENV=local
API_HOST=127.0.0.1
API_PORT=8000
DATABASE_URL=postgresql+psycopg://scopesteps:scopesteps@127.0.0.1:5432/scopesteps
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Comma-separated modules the API mounts. Default: all.
# ENABLED_MODULES=identity,projects,sources,evidence,backlog,change_control,agent,audit

# Model provider (agent module). Server-side only: never prefix with VITE_.
MODEL_PROVIDER=gemini
MODEL_ID=
MODEL_API_KEY=

# Agent run limits (Technical Proposal, section 8)
RUN_MAX_TURNS=6
RUN_MAX_TOOLS=8
RUN_MAX_OUTPUT_TOKENS=8000

# Frontend (public: bundled into the browser). Empty means "same origin via the Vite proxy".
VITE_API_BASE_URL=
