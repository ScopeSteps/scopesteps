# Copy to .env and adjust. Never commit .env.

APP_ENV=local
API_HOST=127.0.0.1
API_PORT=8000
DATABASE_URL=sqlite:///var/scopesteps.db
# Postgres instead (start it with `just db`):
# DATABASE_URL=postgresql+psycopg://scopesteps:scopesteps@127.0.0.1:5432/scopesteps
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Comma-separated modules the API mounts. Default: all.
# ENABLED_MODULES=identity,projects,sources,evidence,backlog,change_control,agent,audit,discussions,notifications

# Where the current user comes from (ADR 0007):
#   session  email and password sign-in with a server-side session cookie. The default.
#   local    every request acts as the seeded Local Reviewer, with no sign-in. For scripted local
#            work only; refused outside APP_ENV=local/test or a non-loopback API_HOST.
AUTH_MODE=session
# Minutes a session lasts from sign-in, and minutes it survives without a request.
SESSION_ABSOLUTE_LIFETIME_MINUTES=720
SESSION_IDLE_TIMEOUT_MINUTES=120
# Password `just seed` gives the synthetic viewer, editor and approver accounts
# (<role>@scopesteps.local). Server-side only. Left empty here on purpose: `just setup` generates
# one in your .env, or set your own (at least 12 characters) and re-run `just seed`. While it is
# empty those accounts cannot sign in.
SEED_ACCOUNT_PASSWORD=

# Emails: sign-up confirmation and invitations (ADR 0019). Links point at APP_BASE_URL, the web
# app as people reach it. Sending is plain SMTP, so the service is a settings change:
#   development  the local Mailpit inbox from `just mail` (the defaults below); nothing reaches a
#                real mailbox. Read it at http://localhost:8025.
#   Postmark     SMTP_HOST=smtp.postmarkapp.com SMTP_PORT=587, username and password: a server
#                token. Recommended for inbox delivery.
#   Resend       SMTP_HOST=smtp.resend.com SMTP_PORT=587, username `resend`, password an API key.
# Before going live, verify the sending domain with SPF and DKIM records at the chosen service.
APP_BASE_URL=http://localhost:5173
EMAIL_FROM=no-reply@scopesteps.local
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USERNAME=
# Server-side only, never prefix with VITE_.
SMTP_PASSWORD=
# Encrypts the Jira API tokens projects connect with (ADR 0029). Unset: Jira cannot be connected.
# Make one with: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# JIRA_TOKEN_KEY=
# The background sender for Jira publishes runs inside the API (in_process) or, with
# `separate`, only in `uv run scopesteps-jira-worker`. It checks every few seconds.
# JIRA_PUBLISH_WORKER=in_process
# JIRA_PUBLISH_INTERVAL_SECONDS=5
# How often the API looks for notification emails that are due (seconds).
# NOTIFICATION_JOB_INTERVAL_SECONDS=30

# Model-call traces and metrics (ADR 0022). Unset: they go to the API log. Set: they are exported
# over OTLP/HTTP to this collector's base URL. `just telemetry` starts a local one at this address.
# Server-side only, never prefix with VITE_.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# A hosted backend's credentials, as comma-separated key=value pairs. A secret: leave it empty.
OTEL_EXPORTER_OTLP_HEADERS=
# OTEL_SERVICE_NAME=scopesteps-api

# Models. Server-side only: never prefix with VITE_.
# MODEL_PROFILE is the checked-in profile new runs pin: a model, effort, output limit and timeout
# for each step (ADR 0032). claude-mix-v1 needs ANTHROPIC_API_KEY, or the API refuses to start.
# A run keeps the profile it started with. Synthetic or de-identified data only.
MODEL_PROFILE=claude-mix-v1
# Paid API key from the Claude Console. Server-side only; never commit it.
ANTHROPIC_API_KEY=
# MODEL_PROFILE=replay answers from a recording of a live run instead of a model, labelled as a
# replay in the app (ADR 0018). Local only. `just e2e` sets these itself; set them here only to
# rehearse the demo offline.
MODEL_REPLAY_FILE=
# Local only: also record each successful live result to this file, to replay later.
MODEL_RECORD_FILE=

# Agent run limits (checked before every model call)
RUN_MAX_TURNS=64
RUN_MAX_TOOLS=8
RUN_MAX_CLARIFICATION_ROUNDS=2
# Suggest tasks for a first draft's stories as soon as it is saved (one call per ten stories).
RUN_SUGGEST_TASKS_AFTER_DRAFT=true
# Runs take each step's output limit from MODEL_PROFILE; this is for the evaluations until they
# pin a profile.
RUN_MAX_OUTPUT_TOKENS=16000
RUN_MAX_TOTAL_TOKENS=600000
# Estimated cost at paid rates, per run and per project (ADR 0032).
RUN_COST_LIMIT_USD=1.50
PROJECT_COST_LIMIT_USD=25
# How long one advance may hold a run; at least twice the profile's longest step timeout
# (840 for claude-mix-v1).
RUN_LEASE_SECONDS=900

# Source upload limits
SOURCE_MAX_BYTES=524288
# Per Word, PDF or WebVTT file (10 MiB).
SOURCE_MAX_DOCUMENT_BYTES=10485760
# Across a project's current sources: several one-hour meetings and their documents.
SOURCE_MAX_WORDS=60000

# Frontend (public: bundled into the browser). Empty means same origin via the Vite proxy.
VITE_API_BASE_URL=
