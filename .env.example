# Copy to .env and adjust. Never commit .env.

APP_ENV=local
API_HOST=127.0.0.1
API_PORT=8000
DATABASE_URL=sqlite:///var/scopesteps.db
# Postgres instead (start it with `just db`):
# DATABASE_URL=postgresql+psycopg://scopesteps:scopesteps@127.0.0.1:5432/scopesteps
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Comma-separated modules the API mounts. Default: all.
# ENABLED_MODULES=identity,projects,sources,evidence,backlog,change_control,agent,audit

# Where the current user comes from (ADR 0007):
#   local    every request acts as the seeded Local Reviewer. Refused outside APP_ENV=local/test
#            or a non-loopback API_HOST. The default until the sign-in screen (SSPOC-29) lands.
#   session  email and password sign-in with a server-side session cookie.
AUTH_MODE=local
# Minutes a session lasts from sign-in, and minutes it survives without a request.
SESSION_ABSOLUTE_LIFETIME_MINUTES=720
SESSION_IDLE_TIMEOUT_MINUTES=120
# Password `just seed` gives the synthetic viewer, editor and approver accounts
# (<role>@scopesteps.local). Server-side only. Left empty here on purpose: choose your own, at
# least 12 characters, in .env and re-run `just seed`. While it is empty those accounts cannot
# sign in.
SEED_ACCOUNT_PASSWORD=

# Model provider. Server-side only: never prefix with VITE_.
# MODEL_PROVIDER picks the one provider the API, probe and evals use: none, gemini or groq.
# Switching is a manual edit, never automatic (ADR 0004, ADR 0006). A run keeps the model it
# started with; change provider between runs, not during one. The selected provider needs its key,
# or the API refuses to start. Synthetic data only on free tiers.
MODEL_PROVIDER=none
# Optional backup for product runs (not probes or evaluations): a run that has not had one
# successful call moves to it when the primary is overloaded, timing out or rate limited, and
# new runs start on it while the primary keeps failing. none disables it.
MODEL_FALLBACK_PROVIDER=none
MODEL_TIMEOUT_SECONDS=30
MODEL_THINKING_LEVEL=minimal

# Gemini (primary, ADR 0004). Free-tier AI Studio key, no billing: https://aistudio.google.com
GEMINI_MODEL_ID=gemini-3.5-flash-lite
GEMINI_API_KEY=

# Groq (backup, ADR 0006). Free-tier key: https://console.groq.com/keys
GROQ_MODEL_ID=openai/gpt-oss-120b
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
# Free tier allows 8K tokens a minute: probes and evaluations pace to it, and one call's output
# is capped to stay inside it.
GROQ_TOKENS_PER_MINUTE=8000
GROQ_MAX_OUTPUT_TOKENS=6000

# Agent run limits (checked before every model call)
RUN_MAX_TURNS=6
RUN_MAX_TOOLS=8
RUN_MAX_CLARIFICATION_ROUNDS=2
RUN_MAX_OUTPUT_TOKENS=8000
RUN_MAX_TOTAL_TOKENS=200000
RUN_COST_LIMIT_USD=
PROJECT_COST_LIMIT_USD=
# How long one advance may hold a run; at least twice MODEL_TIMEOUT_SECONDS.
RUN_LEASE_SECONDS=90

# Source upload limits
SOURCE_MAX_BYTES=524288
SOURCE_MAX_WORDS=6000

# Frontend (public: bundled into the browser). Empty means same origin via the Vite proxy.
VITE_API_BASE_URL=
